# Lista de permitidos: todo queda fuera salvo lo que la imagen necesita, así un archivo nuevo con
# datos privados no entra por olvido. Nunca agregar .env ni backend/tests.
*
!backend/app
!backend/pyproject.toml
!backend/requirements.txt
!frontend/src
!frontend/index.html
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/vite.config.ts
**/__pycache__
**/*.pyc
**/node_modules
**/dist
