# Plantilla de variables de entorno. Copiar a .env (nunca se versiona) y completar.
# Usar 127.0.0.1 y no localhost: en Windows localhost prueba primero IPv6 y tarda ~2 s en conectar.

# Obligatoria. PostgreSQL local (docker compose). En producción, la cadena del proveedor.
DATABASE_URL=postgresql://agentguard:agentguard@127.0.0.1:5433/agentguard

# Pruebas de integración (`pytest -m integracion`): solo contra la base local; se niegan a correr
# con otro host porque pueden vaciarla.
INTEGRACION_DATABASE_URL=postgresql://agentguard:agentguard@127.0.0.1:5433/agentguard

# Puerto de Postgres en el equipo (docker-compose.yml); 5433 para no chocar con uno instalado.
# POSTGRES_PUERTO=5433

# Opcionales
# Origen del frontend si se sirve aparte de la API. Vacío = sin CORS (lo normal: Vite usa un proxy
# en desarrollo y la imagen sirve todo desde el mismo origen).
FRONTEND_ORIGIN=
# Carpeta del build de React. Por defecto, frontend/dist del repo; si no existe, solo se sirve la API.
# FRONTEND_DIST=
# DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
