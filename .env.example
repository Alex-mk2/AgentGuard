# Plantilla de variables de entorno. Copiar a .env (nunca se versiona) y completar.

# PostgreSQL local (docker compose). En producción, la cadena del proveedor.
DATABASE_URL=postgresql://agentguard:agentguard@localhost:5432/agentguard

# Pruebas de integración: solo contra la base local; se niegan a correr con otro host.
INTEGRACION_DATABASE_URL=postgresql://agentguard:agentguard@localhost:5432/agentguard

# Origen del frontend en desarrollo (Vite). En la imagen el backend sirve el build y no hace falta.
FRONTEND_ORIGIN=http://localhost:5173
