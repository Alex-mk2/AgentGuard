# Plantilla de variables de entorno. Copiar a .env (nunca se versiona) y completar.
# Usar 127.0.0.1 y no localhost: en Windows localhost prueba primero IPv6 y tarda ~2 s en conectar.

# Obligatoria. PostgreSQL local (docker compose). En producción, la cadena del proveedor.
DATABASE_URL=postgresql://agentguard:agentguard@127.0.0.1:5434/agentguard

# Pruebas de integración (`pytest -m integracion`): solo contra la base local; se niegan a correr
# con otro host porque pueden vaciarla.
INTEGRACION_DATABASE_URL=postgresql://agentguard:agentguard@127.0.0.1:5434/agentguard

# Puerto de Postgres en el equipo (docker-compose.yml); 5434 para no chocar con un PostgreSQL
# instalado (5432) ni con el de CondorForge (5433).
# POSTGRES_PUERTO=5434
# Puerto de la app en el equipo (docker-compose.yml), si el 8000 está ocupado.
# APP_PUERTO=8000

# Opcionales
# Origen del frontend si se sirve aparte de la API. Vacío = sin CORS (lo normal: Vite usa un proxy
# en desarrollo y la imagen sirve todo desde el mismo origen).
FRONTEND_ORIGIN=
# Carpeta del build de React. Por defecto, frontend/dist del repo; si no existe, solo se sirve la API.
# FRONTEND_DIST=
# DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# Secret Broker (SPEC-0003). Sin SECRETOS_CONFIG el módulo queda apagado (503).
# SECRETOS_CONFIG=config/acciones.json
# Secretos de terceros: AGENTGUARD_SECRETO_<NOMBRE> (mínimo 8 caracteres). Ej.: github_token
# AGENTGUARD_SECRETO_GITHUB_TOKEN=
# Token de cada agente: AGENTGUARD_AGENTE_<ID> (mínimo 16 caracteres, aleatorio)
# AGENTGUARD_AGENTE_SOPORTE=
# Token para ver /secretos/estado
# AGENTGUARD_ADMIN_TOKEN=
# Solo desarrollo: permite acciones http:// hacia localhost
# SECRETOS_HTTP_LOCAL=false

# Control de egresos (SPEC-0004). Sin EGRESOS_CONFIG no sale NINGUNA petición, tampoco del broker.
# EGRESOS_CONFIG=config/egresos.json

# Contención de prompt injection (SPEC-0005). Opcional: sin archivo valen los valores por
# defecto (todas las reglas marcan y toda respuesta externa contamina la sesión).
# INYECCION_CONFIG=config/inyeccion.json
